# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional market-data backups. Yahoo Finance and Brapi do not require keys.
LIVE_QUOTE_DATA_ENABLED=true
FINNHUB_API_KEY=""
ALPHA_VANTAGE_API_KEY=""

# Railway: define NODE_ENV=production. PORT is provided by the platform.
# Keep LIVE_QUOTE_DATA_ENABLED=false to avoid external market-data requests.
# No Supabase or Redis integration is implemented; quote cache is in memory.
#
# GitHub environment "production" for the deployment workflow:
# Secrets: RAILWAY_TOKEN (project token), VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID.
# Variables: RAILWAY_PROJECT_ID, RAILWAY_SERVICE_ID, RAILWAY_ENVIRONMENT_ID,
# RAILWAY_PUBLIC_URL and VERCEL_PUBLIC_URL (actual HTTPS origins, without paths).
# Create/link the projects in Railway and Vercel before running deployment.
# Git-based Vercel deployment is disabled in vercel.json; CI publishes production.
